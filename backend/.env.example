APP_NAME=拾星小宠
DEBUG=true

# Local development default. Docker Compose uses:
# postgresql://pickstarpet:pickstarpet@db:5432/pickstarpet
DATABASE_URL=sqlite:///./pickstarpet.db
TEST_DATABASE_URL=sqlite:///./test.db

# Replace before deploying. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
ALGORITHM=HS256
# Access token lifetime in minutes (default 30 days).
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# RevenueCat server-side configuration.
# Do not use a public SDK key here. Secret API keys usually start with sk_.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_PROJECT_ID=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=premium

# Aliyun Phone Number Verification Service SMS code configuration.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_SCHEME_NAME=拾星小宠
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=https://dypnsapi.aliyuncs.com/
ALIYUN_SMS_CODE_VALID_SECONDS=300
ALIYUN_SMS_RESEND_INTERVAL_SECONDS=60
ALIYUN_SMS_TIMEOUT_SECONDS=5

# Local development only. When true, no Aliyun request is sent; the code is printed
# to backend stdout/stderr logs and checked in memory.
SMS_VERIFICATION_MOCK_ENABLED=false

# Server-side anti-abuse limits.
SMS_SEND_RATE_LIMIT_PER_PHONE_PER_HOUR=5
SMS_SEND_RATE_LIMIT_PER_IP_PER_HOUR=30
SMS_VERIFY_FAILURE_LIMIT_PER_PHONE=5
SMS_VERIFY_FAILURE_LIMIT_PER_IP=30
SMS_VERIFY_FAILURE_WINDOW_SECONDS=600

# Sign in with Apple.
# aud claim must match one of these client IDs (comma-separated).
# For native iOS/macOS: use the app bundle id (com.kkqin.pickstarpet).
# For Android/Web: also add the Apple Services ID.
APPLE_SIGN_IN_CLIENT_IDS=com.kkqin.pickstarpet
APPLE_SIGN_IN_KEYS_URL=https://appleid.apple.com/auth/keys
APPLE_SIGN_IN_TIMEOUT_SECONDS=5
APPLE_SIGN_IN_KEYS_CACHE_SECONDS=3600
